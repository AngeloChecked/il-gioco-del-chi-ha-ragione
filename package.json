{
  "name": "gioco-disagio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/unit/**/*.test.mjs\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report tests/output/report",
    "verifica": "npm test && npm run e2e",
    "serve": "node tests/server.mjs",
    "browsers": "playwright install chromium firefox webkit && node node_modules/@playwright/mcp/node_modules/playwright-core/cli.js install firefox"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/mcp": "^0.0.84",
    "@playwright/test": "^1.64.1",
    "fast-check": "^4.10.2"
  }
}
